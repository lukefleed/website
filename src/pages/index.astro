---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import ThesisLink from "@/components/ThesisLink.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentBlogPosts = sortedPosts;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="space-y-4 pt-8 pb-6">
      <div class="mb-4 sm:float-right sm:ml-4">
        <img
          src="/pania-invernale.jpg"
          alt="Luca Lombardo"
          class="profile-image"
          width={250}
          height={250}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        About Me 🖖
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="mb-4">
        <span class="text-accent">❯</span>
        <span id="typewriter"></span><span id="cursor" class="animate-pulse"
          >|</span
        >
      </p>

      <p class="mb-3">
        I hold a Bachelor's Degree in Mathematics and a Master's Degree in
        Computer Science from the University of Pisa, Italy, where I was also an
        active member of <a
          href="https://phc.dm.unipi.it/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline">PHC</a
        >. My main interests include:
      </p>

      <ul class="mb-6 list-none space-y-1 pl-4">
        <!-- <li class="mb-1">📙 Succinct data structures</li> -->
        <li>📕 Algorithms and data structures</li>
        <li>📗 High-performance computing</li>
        <li>📘 Rust and low-level code optimization</li>
      </ul>

      <div class="mt-6 space-y-3">
        <p
          class="font-mono text-xs font-semibold tracking-wider text-foreground/75 uppercase"
        >
          Research & Selected Work
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <ThesisLink
            href="https://arxiv.org/abs/2606.19213"
            degree="Paper"
            title="Evaluating Rust for Sparse Matrix Kernels in Scientific Computing"
          />
          <ThesisLink
            href="https://github.com/lukefleed/compressed-intvec"
            degree="Rust Library"
            title="Space-efficient compressed representations of integer vectors"
          />
          <ThesisLink
            href="/thesis/master_thesis.pdf"
            degree="Master's Thesis"
            title="Compressed Representations of Set Collections"
          />
          <ThesisLink
            href="/thesis/bachelor_thesis.pdf"
            degree="Bachelor's Thesis"
            title="Efficient Succinct Data Structures on Directed Acyclic Graphs"
          />
        </div>
      </div>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      recentBlogPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentBlogPosts.map(
              (data, index: number) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });

  // Typewriter effect — cleaned up on navigation to avoid leaking timers
  const phrases = [
    "I'm a mathematician",
    "I'm a computer scientist",
    "I'm a mathematician who turned to the dark side of computer science",
  ];

  const typewriterEl = document.getElementById("typewriter");
  if (typewriterEl) {
    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let isWaitingBeforeDelete = false;
    let timerId: ReturnType<typeof setTimeout> | null = null;
    let stopped = false;

    // Cancel all pending timers when navigating away
    document.addEventListener(
      "astro:before-swap",
      () => {
        stopped = true;
        if (timerId !== null) clearTimeout(timerId);
      },
      { once: true }
    );

    function type() {
      if (stopped) return;
      const currentPhrase = phrases[phraseIndex];

      if (isWaitingBeforeDelete) {
        timerId = setTimeout(() => {
          if (stopped) return;
          isWaitingBeforeDelete = false;
          isDeleting = true;
          type();
        }, 1500);
        return;
      }

      if (isDeleting) {
        charIndex--;
      } else {
        charIndex++;
      }

      if (typewriterEl) {
        typewriterEl.textContent = currentPhrase.substring(0, charIndex);
      }

      if (!isDeleting && charIndex === currentPhrase.length) {
        if (phraseIndex === phrases.length - 1) {
          return;
        }
        isWaitingBeforeDelete = true;
        type();
        return;
      }

      if (isDeleting && charIndex === 0) {
        isDeleting = false;
        phraseIndex++;
        if (phraseIndex >= phrases.length) {
          phraseIndex = phrases.length - 1;
          return;
        }
      }

      const speed = isDeleting ? 50 : 70;
      timerId = setTimeout(type, speed);
    }

    type();
  }
</script>
