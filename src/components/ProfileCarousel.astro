---
export interface Props {
  images?: Array<{ src: string; alt: string }>;
}

const images = Astro.props.images ?? [
  { src: "/pania-invernale.jpg", alt: "Luca Lombardo - Pania Invernale" },
  { src: "/propic-dentegigante.jpg", alt: "Luca Lombardo - Dente del Gigante" },
  { src: "/propic-traildolomiti.jpg", alt: "Luca Lombardo - Trail Dolomiti" },
  { src: "/propic-castore.jpg", alt: "Luca Lombardo - Castore" },
  { src: "/propic-surf.jpg", alt: "Luca Lombardo - Surf" },
];
---

<div class="profile-carousel-container relative mb-4 sm:float-right sm:ml-4">
  <div
    id="profile-carousel"
    class="group relative mx-auto h-[250px] w-[250px] overflow-hidden rounded-full border-2 border-accent bg-muted/20 shadow-md"
  >
    <!-- Images -->
    {
      images.map((img, index) => (
        <img
          src={img.src}
          alt={img.alt}
          width={250}
          height={250}
          decoding="async"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "low"}
          class:list={[
            "carousel-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ease-in-out",
            index === 0 ? "z-10 opacity-100" : "z-0 opacity-0",
          ]}
          data-slide-index={index}
        />
      ))
    }

    <!-- Overlay Navigation Arrows (always visible on mobile, hover on desktop) -->
    <button
      type="button"
      id="carousel-prev"
      class="absolute top-1/2 left-2 z-20 -translate-y-1/2 rounded-full bg-background/75 p-1.5 text-foreground opacity-80 transition-opacity duration-200 hover:bg-accent hover:text-white focus:opacity-100 sm:opacity-0 sm:group-hover:opacity-90"
      aria-label="Previous photo"
    >
      <svg
        class="h-4 w-4 rtl:rotate-180"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
    </button>
    <button
      type="button"
      id="carousel-next"
      class="absolute top-1/2 right-2 z-20 -translate-y-1/2 rounded-full bg-background/75 p-1.5 text-foreground opacity-80 transition-opacity duration-200 hover:bg-accent hover:text-white focus:opacity-100 sm:opacity-0 sm:group-hover:opacity-90"
      aria-label="Next photo"
    >
      <svg
        class="h-4 w-4 rtl:rotate-180"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Handwritten Blackboard Note -->
  <div
    class="relative mt-8 flex flex-col items-center px-4 text-center text-accent select-none sm:w-[250px] sm:translate-x-10 sm:items-start sm:px-0 sm:text-left"
  >
    <!-- Mobile Arrow: Centered above text on mobile, pointing UP towards photo circle -->
    <svg
      class="mb-1 h-8 w-8 shrink-0 -rotate-6 transform text-accent sm:hidden"
      viewBox="0 0 50 50"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- Chalk arrow pointing UP towards photo circle -->
      <path d="M 20,44 C 17,30 23,18 20,8"></path>
      <path d="M 11,17 L 20,6 L 29,17"></path>
    </svg>

    <div class="relative inline-block">
      <!-- Desktop Arrow: Centered above text on desktop -->
      <svg
        class="absolute -top-7 left-1/2 hidden h-8 w-8 -translate-x-1/2 -rotate-6 transform text-accent sm:block"
        viewBox="0 0 50 50"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- Chalk arrow pointing UP towards photo circle -->
        <path d="M 20,44 C 17,30 23,18 20,8"></path>
        <path d="M 11,17 L 20,6 L 29,17"></path>
      </svg>

      <span
        class="font-handwriting block -rotate-4 transform text-xl font-semibold tracking-wide text-nowrap sm:text-2xl"
      >
        I really like mountains!
      </span>
    </div>
  </div>
</div>

<script>
  function initProfileCarousel() {
    const container = document.getElementById("profile-carousel");
    if (!container) return;

    const slides = Array.from(
      container.querySelectorAll<HTMLImageElement>(".carousel-slide")
    );
    const prevBtn =
      container.querySelector<HTMLButtonElement>("#carousel-prev");
    const nextBtn =
      container.querySelector<HTMLButtonElement>("#carousel-next");

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const INTERVAL = 4500; // 4.5 seconds

    function goToSlide(index: number) {
      if (index === currentIndex) return;

      slides[currentIndex].classList.remove("opacity-100", "z-10");
      slides[currentIndex].classList.add("opacity-0", "z-0");

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.remove("opacity-0", "z-0");
      slides[currentIndex].classList.add("opacity-100", "z-10");
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(nextSlide, INTERVAL);
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Event listeners for prev/next buttons
    prevBtn?.addEventListener("click", e => {
      e.preventDefault();
      prevSlide();
      startAutoPlay();
    });

    nextBtn?.addEventListener("click", e => {
      e.preventDefault();
      nextSlide();
      startAutoPlay();
    });

    // Pause on hover
    container.addEventListener("mouseenter", stopAutoPlay);
    container.addEventListener("mouseleave", startAutoPlay);

    // Clean up on Astro page swap
    document.addEventListener(
      "astro:before-swap",
      () => {
        stopAutoPlay();
      },
      { once: true }
    );

    startAutoPlay();
  }

  document.addEventListener("astro:page-load", initProfileCarousel);
  initProfileCarousel();
</script>
